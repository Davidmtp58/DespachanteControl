-- Run only after explicit target confirmation, using psql -X -v ON_ERROR_STOP=1.
-- Initial installation only. Any existing schema aborts; no DROP or automatic repair.
\set ON_ERROR_STOP on
BEGIN;
SELECT pg_advisory_xact_lock(74102901);
DO $$ BEGIN
  IF to_regnamespace('app') IS NOT NULL OR to_regnamespace('dc_migrations') IS NOT NULL THEN
    RAISE EXCEPTION 'Destination not empty; review required';
  END IF;
END $$;
\ir ../bootstrap.sql
SET LOCAL ROLE dc_migrator;
\ir ../migrations/001_schema.sql
\ir ../migrations/002_financeiro.sql
\ir ../migrations/003_tipos_servico.sql
\ir ../migrations/004_permissoes.sql
\ir ../migrations/005_unicode_nfc.sql
CREATE SCHEMA dc_migrations AUTHORIZATION dc_migrator;
REVOKE ALL ON SCHEMA dc_migrations FROM PUBLIC;
CREATE TABLE dc_migrations.history(version text PRIMARY KEY, checksum text NOT NULL);
INSERT INTO dc_migrations.history VALUES
