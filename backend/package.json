    "memorystore": "^1.6.8",
    "mssql": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.19.0",
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  }
