# Execute os comandos a partir de backend/. Nenhuma credencial real neste arquivo.
HOST=127.0.0.1
PORT=3001
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
# Alternativa: remova DB_INSTANCE e informe a porta TCP real em DB_PORT.
# Não configure instância e porta simultaneamente.
# DB_PORT=
DB_DATABASE=DespachanteControl
# Preencha localmente com um login SQL Server autorizado no banco existente.
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Apenas para desenvolvimento local com certificado autoassinado, use true.
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT_MS=5000
DB_REQUEST_TIMEOUT_MS=5000
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Diagnóstico estruturado opcional. Desabilitado quando NODE_ENV=production.
# Não imprime mensagens brutas, consultas, parâmetros ou credenciais.
SQL_DIAGNOSTICS=false

# Gere localmente conforme AUTH.md, sem imprimir o segredo no terminal.
SESSION_SECRET=
SESSION_TTL_MINUTES=30
# HTTP local: false. HTTPS: true.
SESSION_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=10
