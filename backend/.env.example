# Execute os comandos a partir de backend/. Nenhuma credencial real neste arquivo.
HOST=127.0.0.1
PORT=3001
# PostgreSQL: todos os módulos, incluindo Dashboard/Financeiro. Veja POSTGRESQL.md.
DB_PROVIDER=sqlserver
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
# Alternativa: remova DB_INSTANCE e informe a porta TCP real em DB_PORT.
# Não configure instância e porta simultaneamente.
# DB_PORT=
DB_DATABASE=DespachanteControl
# Preencha localmente com um login SQL Server autorizado no banco existente.
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Apenas para desenvolvimento local com certificado autoassinado, use true.
DB_TRUST_SERVER_CERTIFICATE=false
DB_CONNECTION_TIMEOUT_MS=5000
DB_REQUEST_TIMEOUT_MS=5000
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Usadas somente com DB_PROVIDER=postgres. Nunca preencha credenciais neste exemplo.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
# verify-full verifica cadeia e identidade do servidor. Nunca desabilitar em hosted.
# disable é permitido apenas para APP_MODE=local com host de loopback.
PG_SSL_MODE=verify-full
# Opcional: caminho local para CA confiável, sem alterar rejectUnauthorized.
# PG_SSL_CA_FILE=
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000

# Diagnóstico estruturado opcional. Desabilitado quando NODE_ENV=production.
# Não imprime mensagens brutas, consultas, parâmetros ou credenciais.
SQL_DIAGNOSTICS=false

# Gere localmente conforme AUTH.md, sem imprimir o segredo no terminal.
SESSION_SECRET=
SESSION_TTL_MINUTES=30
# HTTP local: false. HTTPS: true.
SESSION_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=10
# Servidor local: memory (padrao) ou postgres. Render: configurar postgres no painel.
# Netlify tambem exige postgres; sua integracao permanece inativa nesta etapa.
# Aplicar a migracao 006 separadamente antes de habilitar postgres.
# AUTH_STATE_STORE=postgres

# Padrao local. Para Render, configure as variaveis no painel conforme HOSTING.md.
APP_MODE=local
# Apenas hosted: TRUST_PROXY_HOPS=1, SESSION_COOKIE_SECURE=true,
# AUTH_ALLOWED_ORIGINS=https://seu-piloto.onrender.com, HOST=0.0.0.0 e PORT do Render.

# Optional custom CA certificate file for PostgreSQL TLS verification.
# On Render, configure this as a Secret File at /etc/secrets/supabase-ca.crt.
# PG_SSL_CA_FILE=/path/to/ca.crt
